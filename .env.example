# Required operator-approved settings. VAT is set to the approved 8% rate; secrets and
# deployment-specific values remain blank and must be supplied by the operator.
# For local Google + email OTP sign-in, set these values in your ignored .env file.
GOOGLE_CLIENT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM=
# Local/received database: copy to .env, set the actual host/schema and local DB credentials.
# Shared database/dump => SAME original AES/HMAC keys on every machine.
# Independent new database => generate keys ONCE with scripts/initialize-database.ps1.
# Never run the initializer against a received dump; retain its matching keys.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
# Optional full JDBC URL overrides DB_HOST/DB_PORT/DB_NAME. Leave blank otherwise.
DB_URL=
DB_ALLOW_LOCAL_FALLBACK=false
DB_USER=
DB_PASSWORD=
DB_ROOT_PASSWORD=
JWT_SECRET=
AES_VAULT_KEY=
HMAC_IDENTITY_KEY=
# Each vault key must be Base64 encoded, exactly 32 bytes; retain existing keys.
# JWT_SECRET is stable and contains at least 32 UTF-8 bytes. Do not regenerate at startup.
# Alternative *_FILE settings are supported; configure only one source per secret.
HOTEL_VAT_RATE=0.08
# Local, trusted RAG endpoint. The Java gateway accepts loopback HTTP only.
AI_RAG_URL=http://127.0.0.1:8082/rag/query
BANK_BIN=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=
BANK_WEBHOOK_SECRET=
# Keep payOS for normal operation. Set mock only for local testing; it enables a simulated payment button.
PAYMENT_QR_PROVIDER=payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_BANK_BIN=
PAYOS_ACCOUNT_NUMBER=
PAYOS_ACCOUNT_NAME=
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=
# Enable only after checking SMTP with a designated test mailbox.
NOTIFICATION_EMAIL_ENABLED=false
MANAGER_PIN_HASH=
HOTEL_LEGAL_NAME=
HOTEL_LEGAL_ADDRESS=
HOTEL_TAX_CODE=
# MISA meInvoice stays disabled until the seller confirms its registered invoice method and configures a trial account.
MISA_EINVOICE_ENV=test
MISA_EINVOICE_MODE=
MISA_EINVOICE_APP_ID=
MISA_EINVOICE_TAX_CODE=
MISA_EINVOICE_USERNAME=
MISA_EINVOICE_PASSWORD=
MISA_EINVOICE_SERIES=
MISA_EINVOICE_TEMPLATE_ID=
MISA_EINVOICE_NAME=
HOTEL_OTP_MODE=
# mock is approved only for development/tests; production requires approved delivery integration.
HOTEL_MEDIA_PROVIDER=local
HOTEL_MEDIA_DIR=.data/media
# Optional Cloudflare R2 S3-compatible object storage settings.
# Set HOTEL_MEDIA_PROVIDER=r2 after filling the required values below; leave local for disk storage.
# Create an R2 API token with Object Read & Write limited to this bucket.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional public base URL (custom domain or development r2.dev URL), without a trailing slash.
R2_PUBLIC_BASE_URL=
